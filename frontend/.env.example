# WorkDex frontend muhit o'zgaruvchilari.
# Bu faylni `.env` (yoki `.env.local`) nomi bilan ko'chirib oling va qiymatni to'ldiring.
# DIQQAT: Vite dagi VITE_ prefiksli qiymatlar bundle ichiga tushadi va brauzerda
# ko'rinadi — bu yerga hech qanday maxfiy kalit yozilmasin.

# API manzili. Ko'rsatilmasa, manzil brauzerning hostname/protokolidan
# avtomatik aniqlanadi (masalan http://<host>:5082/api), lokalda esa
# http://localhost:5082/api ishlatiladi.
# VITE_API_URL=https://api.example.uz/api
